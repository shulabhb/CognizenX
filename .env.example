# PostHog (US Cloud — match your project region)
# Never commit real tokens. Keep values in local .env only.
POSTHOG_PROJECT_TOKEN=phc_your_project_token_here
POSTHOG_HOST=https://us.i.posthog.com

# Sentry (P0.7) — mindmitra-mobile project DSN
SENTRY_DSN=https://your_key@o000.ingest.us.sentry.io/000
SENTRY_ENVIRONMENT=development
# Set to 1 once to send a test error on app boot in __DEV__, then turn off
SENTRY_SEND_TEST_ERROR=0
